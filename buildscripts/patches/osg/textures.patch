 using namespace osg;
 
+namespace
+{
+    // WebGL2/GLES3: glTexImage2D's source 'format' argument must be an unsized *base*
+    // format (GL_RGBA, GL_RGB, GL_RED, ...). For an image-less RTT texture OSG passes the
+    // (possibly sized) _internalFormat as the source format, which WebGL2 rejects
+    // (e.g. GL_RGBA8 is not a valid source format) -> texture stays undefined and its FBO
+    // is incomplete (0x8cd6). Map a sized/base internal format to a valid base source format.
+    GLenum baseSourceFormatES(GLenum internalFormat)
+    {
+        // Only the sized *color* formats used for image-less RTTs need remapping; depth/float
+        // RTTs set _sourceFormat/_sourceType explicitly so they never reach here. Base formats
+        // (GL_RGBA/GL_RGB/...) are already valid source formats and pass through unchanged.
+        switch (internalFormat)
+        {
+            case GL_RGBA8: case GL_SRGB8_ALPHA8:
+                return GL_RGBA;
+            case GL_RGB8: case GL_SRGB8:
+                return GL_RGB;
+            default:
+                return internalFormat;
+        }
+    }
+}
