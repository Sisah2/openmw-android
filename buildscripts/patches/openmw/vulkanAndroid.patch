+extern "C" {
+
+VkResult vkEnumerateInstanceVersion(uint32_t* pApiVersion)
+{
+    if (!p_vkEnumerateInstanceVersion)
+    {
+        PFN_vkGetInstanceProcAddr gipa = (PFN_vkGetInstanceProcAddr)vkGetInstanceProcAddr(nullptr, "vkGetInstanceProcAddr");
+        if (gipa)
+            p_vkEnumerateInstanceVersion = (PFN_vkEnumerateInstanceVersion)gipa(nullptr, "vkEnumerateInstanceVersion");
+    }
+    if (p_vkEnumerateInstanceVersion)
+        return p_vkEnumerateInstanceVersion(pApiVersion);
+    if (pApiVersion)
+        *pApiVersion = VK_API_VERSION_1_0;
+    return VK_SUCCESS;
+}
+
+void vkGetPhysicalDeviceProperties2(VkPhysicalDevice physicalDevice, VkPhysicalDeviceProperties2* pProperties)
+{
