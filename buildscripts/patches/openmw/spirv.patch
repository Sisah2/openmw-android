+
+    private:
+        static std::vector<unsigned int> glslToSpirv(osg::Shader::Type type, int glslVersion, const char* shaderSrc, int& errc);
+        static std::string spirvToEssl(const std::vector<unsigned int>& spirv, unsigned int esslVersion, int& errc);
+    };
+}
