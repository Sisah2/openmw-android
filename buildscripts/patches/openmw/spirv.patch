new file mode 100755
index 00000000000..6a7fe1f2216
--- /dev/null
+++ b/cmake/FindSPIRV-Cross.cmake
@@ -0,0 +1,31 @@
+if(TARGET spirv-cross-c)
+    return()
+endif()
+
+# Define core components
+add_library(spirv-cross-core STATIC IMPORTED)
+set_target_properties(spirv-cross-core PROPERTIES
+        IMPORTED_LOCATION "${CMAKE_INSTALL_PREFIX}/lib/libspirv-cross-core.a"
+)
+
+add_library(spirv-cross-glsl STATIC IMPORTED)
+set_target_properties(spirv-cross-glsl PROPERTIES
+        IMPORTED_LOCATION "${CMAKE_INSTALL_PREFIX}/lib/libspirv-cross-glsl.a"
+        INTERFACE_LINK_LIBRARIES "spirv-cross-core"
+)
+
+add_library(spirv-cross-reflect STATIC IMPORTED)
+set_target_properties(spirv-cross-reflect PROPERTIES
+        IMPORTED_LOCATION "${CMAKE_INSTALL_PREFIX}/lib/libspirv-cross-reflect.a"
+)
+
+# Define C wrapper
+add_library(spirv-cross-c STATIC IMPORTED)
+set_target_properties(spirv-cross-c PROPERTIES
+        IMPORTED_LOCATION "${CMAKE_INSTALL_PREFIX}/lib/libspirv-cross-c.a"
+        INTERFACE_INCLUDE_DIRECTORIES "${CMAKE_INSTALL_PREFIX}/include/spirv_cross"
+        INTERFACE_LINK_LIBRARIES "spirv-cross-glsl;spirv-cross-core;spirv-cross-reflect"
+)
+
+# Provide the case-sensitive alias if needed
+add_library(SPIRV-Cross::spirv-cross-c ALIAS spirv-cross-c)
