+    int getGLSLVersion(const std::string& code) {
+        static std::regex version_pattern(R"r(#version\s+(\d{3}))r");
+        std::smatch match;
+        if (std::regex_search(code, match, version_pattern)) {
+            return std::stoi(match[1].str());
+        }
+        return 120; // Default to 120 if not found
+    }
+}
+
+namespace Shader
+{
+    static bool glslang_inited = false;
+
+std::string removeLayoutBinding(const std::string& glslCode) {
+    static std::regex bindingRegex(R"(layout\s*\(\s*binding\s*=\s*\d+\s*\)\s*)");
+    std::string result = std::regex_replace(glslCode, bindingRegex, "");
+    static std::regex bindingRegex2(R"(layout\s*\(\s*binding\s*=\s*\d+\s*,)");
+    result = std::regex_replace(result, bindingRegex2, "layout(");
+    return result;
+}
+
+    std::string ShaderConverter::convertGLSLtoGLES(const std::string& glslSource, osg::Shader::Type type, unsigned int glesVersion)
+    {
+        if (!glslang_inited) {
+            glslang::InitializeProcess();
+            glslang_inited = true;
+        }
+
+        int glslVersion = getGLSLVersion(glslSource);
+        int errc = 0;
+
+        std::vector<unsigned int> spirv = glslToSpirv(type, glslVersion, glslSource.c_str(), errc);
+        if (errc != 0 || spirv.empty())
+        {
+            Log(Debug::Error) << "Failed to convert GLSL to SPIR-V";
+            return glslSource; // Return original source on failure
+        }
+
+        std::string essl = spirvToEssl(spirv, glesVersion, errc);
+        if (errc != 0 || essl.empty())
+        {
+            Log(Debug::Error) << "Failed to convert SPIR-V to ESSL";
+            return glslSource;
+        }
+
+        return essl;
+    }
+
+    std::vector<unsigned int> ShaderConverter::glslToSpirv(osg::Shader::Type type, int glslVersion, const char* shaderSrc, int& errc)
+    {
+        EShLanguage shader_language;
+        switch (type) {
+            case osg::Shader::VERTEX: shader_language = EShLangVertex; break;
+            case osg::Shader::FRAGMENT: shader_language = EShLangFragment; break;
+            case osg::Shader::GEOMETRY: shader_language = EShLangGeometry; break;
+            case osg::Shader::COMPUTE: shader_language = EShLangCompute; break;
+            case osg::Shader::TESSCONTROL: shader_language = EShLangTessControl; break;
+            case osg::Shader::TESSEVALUATION: shader_language = EShLangTessEvaluation; break;
+            default:
+                errc = -1;
+                return {};
+        }
+
+        glslang::TShader shader(shader_language);
+        shader.setStrings(&shaderSrc, 1);
+
+        shader.setEnvInput(glslang::EShSourceGlsl, shader_language, glslang::EShClientOpenGL, glslVersion);
+        shader.setEnvClient(glslang::EShClientOpenGL, glslang::EShTargetOpenGL_450);
+        shader.setEnvTarget(glslang::EShTargetSpv, glslang::EShTargetSpv_1_0);
+        shader.setAutoMapLocations(true);
+        shader.setAutoMapBindings(true);
+
+        TBuiltInResource resources = InitResources();
+
+        if (!shader.parse(&resources, glslVersion, true, EShMsgDefault)) {
+            Log(Debug::Error) << "glslang parse error: " << shader.getInfoLog();
+            errc = -1;
+            return {};
+        }
+
+        glslang::TProgram program;
+        program.addShader(&shader);
+
+        if (!program.link(EShMsgDefault)) {
+            Log(Debug::Error) << "glslang link error: " << program.getInfoLog();
+            errc = -1;
+            return {};
+        }
+
+        std::vector<unsigned int> spirv_code;
+        glslang::SpvOptions spvOptions;
+        spvOptions.disableOptimizer = false;
+        glslang::GlslangToSpv(*program.getIntermediate(shader_language), spirv_code, &spvOptions);
+        errc = 0;
+        return spirv_code;
+    }
+
+    std::string ShaderConverter::spirvToEssl(const std::vector<unsigned int>& spirv, unsigned int esslVersion, int& errc)
+    {
+        spvc_context context = nullptr;
+        spvc_parsed_ir ir = nullptr;
+        spvc_compiler compiler_glsl = nullptr;
+        spvc_compiler_options options = nullptr;
+        const char* result = nullptr;
+
+        spvc_context_create(&context);
+        if (!context) {
+            errc = -1;
+            return "";
+        }
+
+        spvc_context_parse_spirv(context, spirv.data(), spirv.size(), &ir);
+        spvc_context_create_compiler(context, SPVC_BACKEND_GLSL, ir, SPVC_CAPTURE_MODE_TAKE_OWNERSHIP, &compiler_glsl);
+
+        if (!compiler_glsl) {
+            spvc_context_destroy(context);
+            errc = -1;
+            return "";
+        }
+
+        spvc_compiler_create_compiler_options(compiler_glsl, &options);																															
+        spvc_compiler_options_set_uint(options, SPVC_COMPILER_OPTION_GLSL_VERSION, esslVersion >= 300 ? esslVersion : 300);
+        spvc_compiler_options_set_bool(options, SPVC_COMPILER_OPTION_GLSL_ES, SPVC_TRUE);
+        spvc_compiler_install_compiler_options(compiler_glsl, options);
+
+        spvc_compiler_compile(compiler_glsl, &result);
+
+        if (!result) {
+            spvc_context_destroy(context);
+            errc = -1;
+            return "";
+        }
+
+        std::string essl = result;
+        spvc_context_destroy(context);
+
+        errc = 0;
+
+        essl.insert(16, "#extension GL_OES_standard_derivatives : enable\nprecision highp float;\nprecision highp int;\n");
+        essl = removeLayoutBinding(essl);
+
+        return essl;
+    }
+}
